{
  "name": "gk-nfc-reader",
  "version": "1.0.27",
  "description": "Expo Module to read the Personal Data of the electronic Health Card holder via NFC",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "prettier": "npx prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android"
  },
  "files": [
    "android/build.gradle",
    "android/src/main",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "ios",
    "plugin/build",
    "!ios/Tests/**"
  ],
  "keywords": [
    "react-native",
    "expo",
    "ExpoEHCNFC",
    "electronicHealthcard",
    "NFC"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/priska96/gk-nfc-reader.git"
  },
  "bugs": {
    "url": "https://github.com/priska96/gk-nfc-reader/issues"
  },
  "author": "Priska Kohnen <priskakohnen@gmail.com> ()",
  "license": "ISC",
  "homepage": "https://github.com/priska96/gk-nfc-reader#readme",
  "devDependencies": {
    "@types/react": "~19.0.10",
    "expo": "^53.0.26",
    "expo-build-properties": "~0.14.8",
    "expo-module-scripts": "^4.1.10",
    "prettier": "2.8.1",
    "react": "^19.0.0",
    "react-native": "^0.79.6",
    "typescript": "~5.8.3"
  },
  "peerDependencies": {
    "expo": ">=52.0.0 || ^54.0.0",
    "react": "^19.0.0",
    "react-native": ">=0.79.6|| ^0.81.0"
  }
}
